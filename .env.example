# Copy to .env (never commit .env). Server-side only — these values never reach the browser.

# Telegram bot that posts requests into the MOMENTO work chat (token from @BotFather).
NUXT_TELEGRAM_BOT_TOKEN=
# Id of the work chat (a group id is negative, e.g. -1001234567890). The bot must be a member.
NUXT_TELEGRAM_CHAT_ID=

# Local testing only: point requests to a stub instead of api.telegram.org.
# NUXT_TELEGRAM_API_BASE=http://127.0.0.1:8787
